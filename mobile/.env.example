# FinFlow Mobile Environment Configuration
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Any variable prefixed with EXPO_PUBLIC_* is embedded into the client application bundle
# at build time and is publicly readable by anyone inspecting the app.
# NEVER put secret keys (e.g. database credentials, server private keys, JWT secrets) in this file.

# Base API URL:
# For development on physical devices, use your machine's LAN IP (e.g., http://192.168.1.10:5000/api).
# For production builds, this MUST be an HTTPS URL (e.g., https://api.finflow.app/api).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000/api

# Google OAuth Client IDs (Public identifiers)
# Web Client ID (used by backend to verify ID tokens, and by Android/iOS clients)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# iOS Client ID from Google Cloud Console (required for iOS native sign-in)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Android Client ID from Google Cloud Console
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
