{
  "expo": {
    "name": "FinFlow",
    "slug": "finflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "finflow",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#176B87"
    },
    "android": {
      "package": "com.finflow.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#176B87"
      }
    },
    "ios": {
      "bundleIdentifier": "com.finflow.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.your-google-ios-client-id"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "44aee52d-1731-496c-94cd-95c1c7b501fd"
      }
    }
  }
}
